{
  "name": "HorArio_comercial",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const data = new Date();\n\n  // Ajustar para timezone de São Paulo (UTC-3 ou UTC-2 no horário de verão, se aplicável)\n  const dataSP = new Date(data.toLocaleString(\"en-US\", { timeZone: \"America/Sao_Paulo\" }));\n\n  const diaSemana = dataSP.getDay(); // 0 = domingo, 1 = segunda, ..., 6 = sábado\n  const hora = dataSP.getHours();\n\n  let horarioComercial = false;\n\n  if (diaSemana >= 1 && diaSemana <= 5) {\n    horarioComercial = hora >= 9 && hora < 18;\n  } else if (diaSemana === 6) {\n    horarioComercial = hora >= 9 && hora < 14;\n  }\n\n  results.push({\n    json: {\n      ...item.json,\n      horarioComercial\n    }\n  });\n}\n\nreturn results;\n"
      },
